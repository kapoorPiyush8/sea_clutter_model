    # FMCW beat signal formula (exact)
    fb = Slope * tau
    fd = 2*v/lambda_c

    # Total beat signal includes both range beat and Doppler phase
    beat = np.exp(1j * 2*np.pi * (fb * t_fast + fd * t_slow[m]))

    radar_cube[m, :] = beat

